{
  "name": "brizo",
  "productName": "Brizo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "icons:prepare": "python3 scripts/prepare-app-icons.py",
    "desktop": "npm run build && electron electron/main.mjs",
    "desktop:dev": "node scripts/run-desktop-dev.mjs",
    "desktop:run": "electron electron/main.mjs",
    "agent:install": "node scripts/install-brizo-agent.mjs",
    "desktop:startup-benchmark": "electron electron/main.mjs --startup-benchmark",
    "desktop:browser-smoke": "npm run build && electron electron/main.mjs --browser-smoke",
    "desktop:ctrip-smoke": "electron tests/ctrip-flight-live-smoke.cjs",
    "desktop:taobao-smoke": "electron tests/taobao-price-live-smoke.cjs",
    "desktop:pdf-smoke": "npm run build && electron electron/main.mjs --pdf-smoke",
    "desktop:search-smoke": "electron electron/main.mjs --search-smoke",
    "search:configure": "electron electron/main.mjs --configure-search-keys",
    "desktop:smoke": "npm run build && electron electron/main.mjs --smoke-test",
    "dist": "npm run icons:prepare && npm run build && electron-builder",
    "dist:mac": "npm run icons:prepare && npm run build && electron-builder --mac",
    "dist:win": "npm run icons:prepare && npm run build && electron-builder --win",
    "dist:linux": "npm run icons:prepare && npm run build && electron-builder --linux",
    "preview": "vite preview",
    "perf:startup": "node scripts/benchmark-startup.mjs",
    "perf:compare": "npm run build && node scripts/benchmark-browser-performance.mjs --pack",
    "test": "npm run test:search && npm run test:brief && npm run test:password && npm run test:hygiene && npm run test:browser-agent && npm run test:security && npm run test:performance && npm run test:sites",
    "test:brief": "node --test tests/brief-service.test.mjs",
    "test:browser-agent": "node --test tests/browser-command-agent.test.mjs tests/browser-command-safety.test.mjs tests/browser-execution-evidence.test.mjs tests/browser-observation-v2.test.mjs tests/browser-postconditions.test.mjs tests/use-result-audit.test.mjs",
    "test:hygiene": "node --test tests/site-hygiene.test.mjs tests/adblock-manager.test.mjs",
    "test:search": "node --test tests/search-*.test.mjs",
    "test:password": "node --test tests/password-vault.test.mjs tests/credential-fill-broker.test.mjs tests/expiring-clipboard.test.mjs",
    "test:performance": "node --test tests/performance-lifecycle.test.mjs tests/font-asset.test.mjs tests/browser-performance-benchmark.test.mjs tests/renderer-bundle-hygiene.test.mjs",
    "test:security": "node --test tests/browser-command-safety.test.mjs tests/credential-fill-broker.test.mjs tests/diagnostic-safety.test.mjs tests/expiring-clipboard.test.mjs tests/remote-image-proxy.test.mjs tests/renderer-image-localizer.test.mjs tests/security-boundaries.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "@mozilla/readability": "^0.6.0",
    "border-beam": "^1.3.0",
    "cheerio": "^1.1.2",
    "pdfjs-dist": "^6.2.108",
    "tldts": "^7.4.10"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "com.brizo.browser",
    "productName": "Brizo",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Brizo"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Office",
      "target": [
        "AppImage"
      ]
    }
  }
}
